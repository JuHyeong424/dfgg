{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "start": "webpack server --mode development",
    "build:main": "tsc -p tsconfig.main.json",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "typecheck": "tsc --noEmit",
    "electron:start": "pnpm build:main && electron .",
    "electron:dev": "concurrently -k \"pnpm start\" \"wait-on http://localhost:3001 && pnpm electron:start\""
  },
  "dependencies": {
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron-is-dev": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^4.9.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  }
}
